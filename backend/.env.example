# 填入你的 OpenAI / OpenAI 兼容服务 Key
OPENAI_API_KEY=sk-xxxxxx

# 可选:指向 OpenAI 兼容服务(DeepSeek / 智谱 / Ollama 等)
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_BASE_URL=http://localhost:11434/v1

# 模型名
OPENAI_MODEL=gpt-4o-mini

# 后端监听
HOST=0.0.0.0
PORT=8000

# 允许的前端来源(逗号分隔)
CORS_ORIGINS=http://localhost:5173

# ====== LLM 超时与重试 ======
# 连接上游 LLM 的超时时间(秒),建立 TCP/TLS 连接阶段
LLM_CONNECT_TIMEOUT=5
# 读取响应的整体超时时间(秒),非流式请求的最长等待时间
LLM_READ_TIMEOUT=60
# 首个 token 超时时间(秒),流式请求等待第一个返回块的最长时间
FIRST_TOKEN_TIMEOUT=60
# 相邻流式块之间的超时时间(秒),两个 chunk 间隔超过则判定为断流
CHUNK_TIMEOUT=60
# 请求失败时的最大尝试次数(次,包含首次请求)
LLM_MAX_ATTEMPTS=10
# 重试退避的基础延迟(秒),实际延迟按指数退避放大(如 1s, 2s, 4s ...)
LLM_RETRY_BASE_DELAY=1
